# Copy to .env and change every secret before any shared demo.
# Docker env files do not support inline comments; keep comments on their own lines.

# LAN IP of the laptop so the payer phone can open QR links.
AWAAZ_PUBLIC_BASE_URL=http://192.168.1.50:8000
AWAAZ_GATEWAY_SIGNING_KEY=change-me-gateway-key
# Must match DEVICE_SECRET in firmware/include/config.h
AWAAZ_DEMO_DEVICE_SECRET=change-me-device-secret
AWAAZ_MQTT_USERNAME=awaaz-backend
AWAAZ_MQTT_PASSWORD=change-me-mqtt-backend
AWAAZ_CORS_ORIGINS=http://localhost:3000
AWAAZ_STAFF_TOKENS=change-me-rm:rm:Sana (RM),change-me-sup:supervisor:Imran (Supervisor)
AWAAZ_SIM_SLOW_DELAY_S=20
AWAAZ_CLAIM_WINDOW_MIN=15

# Speech (optional). "none" = keypad and text only.
AWAAZ_STT_PROVIDER=none
AWAAZ_STT_BASE_URL=https://api.openai.com/v1
AWAAZ_STT_API_KEY=
AWAAZ_STT_MODEL=whisper-1
AWAAZ_STT_LANGUAGE=ur

# LLM fallback for intent only (optional).
AWAAZ_LLM_ENABLED=false
ANTHROPIC_API_KEY=
AWAAZ_LLM_MODEL=claude-haiku-4-5-20251001
